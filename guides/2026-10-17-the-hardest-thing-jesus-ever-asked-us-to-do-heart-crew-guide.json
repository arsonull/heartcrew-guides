                  "displayText": "1 John 4:7-11",
                  "reference": {
                    "book": "1 John",
                    "bookId": "1JN",
                    "chapter": 4,
                    "verseStart": 7,
                    "verseEnd": 11
                  },
                  "references": [
                    {
                      "book": "1 John",
                      "bookId": "1JN",
                      "chapter": 4,
                      "verseStart": 7,
                      "verseEnd": 11
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " God's love for you is proven by His ultimate act of love-sending Jesus into the world to die for you so that you could be brought into the family of God."
                }
              ]
            },
            {
              "segments": [
                {
