{
  "id": "2026-09-05-your-christian-resume-won-t-save-you-heart-crew-guide",
  "date": "2026-09-05",
  "seriesTitle": "God Isn't Impressed",
  "sermonTitle": "Your Christian Resume Won't Save You",
  "speaker": null,
