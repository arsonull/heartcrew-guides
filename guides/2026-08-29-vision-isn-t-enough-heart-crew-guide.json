                  "verseEnd": 47
                }
              ]
            },
            {
              "type": "text",
              "text": ", "
            },
            {
              "type": "scripture",
              "displayText": "Philippians 2:1-11",
              "reference": {
                "book": "Philippians",
                "bookId": "PHP",
                "chapter": 2,
                "verseStart": 1,
                "verseEnd": 11
              },
              "references": [
                {
